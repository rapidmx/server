{
  "name": "server",
  "version": "1.0.0-beta.45",
  "description": "The RapidMX mail server: webmail, calendar, contacts, Exchange ActiveSync and MAPI, and end-to-end encryption.",
  "type": "module",
  "repository": "https://github.com/rapidmx/server",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MPL-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rapidrest build && node scripts/precompress-assets.mjs",
    "debug": "rapidrest dev --inspect",
    "dev": "rapidrest dev",
    "lint": "eslint ./src ./test",
    "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
    "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
    "dependency-check": "yarn dlx depcheck \"$@\"",
    "report-coverage": "cat ./coverage/lcov.info | coveralls",
    "profile:process": "node --prof-process --call-graph",
    "profile:view": "npx speedscope",
    "start": "rapidrest start",
    "test": "rapidrest test --coverage",
    "test:watch": "rapidrest --watch --coverage",
    "release": "rapidrest release"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.906.0",
    "@rapidmx/restapi": "^0.35.0",
    "@rapidmx/web-client": "^0.37.0",
    "@rapidrest/core": "^6.0.0",
    "@rapidrest/react": "2.1.0",
    "@rapidrest/service-core": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acme-client": "^5.4.0",
    "axios": "^1.20.0",
    "lodash-es": "^4.18.1",
    "mongodb": "^7.6.0",
    "nconf": "^0.13.0",
    "nodemailer": "^10.0.13",
    "openapi3-ts": "^4.6.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "pst-extractor": "^1.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.7",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "typeorm": "^1.1.1",
    "vite": "^8.3.5",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@rapidrest/cli": "^2.1.0",
