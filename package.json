    "uuid": "^14.0.2",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "dompurify@npm:^3.4.15": "^3.4.17",
    "axios": "^1.19.0",
    "brace-expansion@npm:^1.1.7": "^1.1.21",
    "brace-expansion@npm:^2.0.2": "^2.1.7",
    "brace-expansion@npm:^5.0.8": "^5.0.12",
    "follow-redirects@npm:^1.16.0": "^1.16.2",
    "form-data@npm:~2.3.2": "^4.0.6",
    "handlebars@npm:^4.7.9": "^4.7.10",
    "http-cache-semantics@npm:^4.1.1": "^4.3.0",
    "json-schema": "^0.4.0",
    "markdown-it@npm:^14.3.0": "^14.3.3",
