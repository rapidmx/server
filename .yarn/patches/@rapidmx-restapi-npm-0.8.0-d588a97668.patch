+ */
+class RegistrySession {
+    constructor(createClient) {
+        this.createClient = createClient;
+        this.clients = new Map();
+    }
+    getPackage(name) {
+        return this.client(name).getPackage(name);
+    }
+    getVersion(name, version) {
