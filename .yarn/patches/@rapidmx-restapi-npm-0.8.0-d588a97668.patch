+ * unconfigured `trustedAuthservId`, an empty `fromDomain`, or no qualifying signature.
+ */
+export function isHeaderOversignedByAlignedDkim(raw, headerName, fromDomain, authenticationResults, trustedAuthservId) {
+    const from = (fromDomain ?? "").toLowerCase().replace(/\.$/, "");
+    if (!from || !trustedAuthservId) {
+        return false;
+    }
