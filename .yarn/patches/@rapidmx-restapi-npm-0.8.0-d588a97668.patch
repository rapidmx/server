+export function isDuplicateKeyError(err) {
+    if (!err) {
+        return false;
+    }
+    if (err.code === 11000 || err.code === "23505" || err.code === "ER_DUP_ENTRY" || err.code === "SQLITE_CONSTRAINT_UNIQUE") {
