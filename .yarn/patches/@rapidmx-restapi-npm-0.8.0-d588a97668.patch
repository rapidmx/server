+    saveStep(obj: {
+        currentStep?: string;
+    } | undefined, user?: JWTUser): Promise<SetupStatus>;
+    complete(user?: JWTUser): Promise<SetupStatus>;
+    /** Sends administrators back through the wizard, starting from its first step. */
+    reopen(user?: JWTUser): Promise<SetupStatus>;
+}
