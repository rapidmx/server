+/** Loads a `LegalHoldIndex` - see its doc comment. */
+export async function loadLegalHoldIndex(objectFactory, matterClass) {
+    const repo = await getMatterRepo(objectFactory, matterClass);
+    const open = (await findAllMatters(repo)).filter((matter) => !matter.closedAt);
+    const byMailbox = new Map();
+    for (const matter of open) {
+        for (const mailboxUid of matter.custodianMailboxUids ?? []) {
+            const list = byMailbox.get(mailboxUid) ?? [];
+            list.push(matter);
+            byMailbox.set(mailboxUid, list);
+        }
+    }
+    return {
+        heldMailboxUids: new Set(byMailbox.keys()),
+        isHeld(mailboxUid, referenceDate) {
+            const matters = byMailbox.get(mailboxUid) ?? [];
+            if (!referenceDate) {
+                return matters.length > 0;
+            }
+            return matters.some((matter) => matterCovers(matter, referenceDate));
+        },
+    };
+}
+function matterCovers(matter, referenceDate) {
+    return (referenceDate.getTime() >= new Date(matter.dateRangeStart).getTime() &&
+        referenceDate.getTime() <= new Date(matter.dateRangeEnd).getTime());
+}
