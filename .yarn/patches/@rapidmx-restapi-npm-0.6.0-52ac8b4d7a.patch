+        await requireEscrowHolder(this._objectFactory, this.escrowScopeClass, matter.escrowScopeId, user);
+        const created = await this.requestRepo.create(new this.matterExportRequestClass({ matterId: matter.uid, requestedByUserUid: user.uid, status: "pending" }), { ignoreACL: true });
