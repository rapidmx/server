+                        }
+                        await this.attachmentRepo.delete(attachment.uid, { ignoreACL: true, purge: true });
+                    }
+                    catch (err) {
+                        this.logger?.warn(`RetentionEnforcementJob: failed to purge attachment ${attachment.uid} for expired message ${message.uid}: ${err.message}`);
+                    }
+                }
+                await this.blobStore.delete(message.bodyBlobKey);
+                if (message.sanitizedHtmlBlobKey) {
+                    await this.blobStore.delete(message.sanitizedHtmlBlobKey);
+                }
+                await this.messageRepo.delete(message.uid, { ignoreACL: true, purge: true });
