+        super(...arguments);
+        this.scheduleExpr = "*/30 * * * * *";
+        // One uploaded file per run - see this class's own doc comment for why (unlike `DataExportJob`'s 10).
+        this.batchSize = 1;
+    }
+    get schedule() {
+        return this.scheduleExpr;
+    }
