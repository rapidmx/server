+    const repo = await getEscrowScopeRepo(objectFactory, escrowScopeClass);
+    const scope = await repo.findOne(scopeId, { ignoreACL: true });
+    if (!scope) {
+        throw new ApiError(ApiErrors.NOT_FOUND, 404, ApiErrorMessages.NOT_FOUND);
+    }
