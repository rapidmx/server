+}, {
+    readonly id: "domain";
+    readonly title: "Domain";
+    readonly intro: "Add the domain this server receives mail for, then publish the DNS records below.";
+}, {
+    readonly id: "settings";
+    readonly title: "Server settings";
+    readonly intro: "Set the rules for encryption, how long mail is kept, and new mailboxes.";
+}, {
+    readonly id: "escrow";
+    readonly title: "Escrow";
+    readonly intro: "Decide whether encrypted mail can be recovered by a trusted group of holders.";
+}, {
+    readonly id: "branding";
+    readonly title: "Branding";
+    readonly intro: "Make the sign-in page and apps look like your organization.";
+}, {
+    readonly id: "mailboxes";
+    readonly title: "Mailboxes";
+    readonly intro: "Create the first mailboxes, starting with your own.";
+}];
+export type SetupStepId = (typeof SETUP_STEPS)[number]["id"];
+export interface SetupWizardProps {
+    userUid: string;
+}
+/**
+ * The first-run setup wizard. Each step saves as the administrator works through it; the wizard itself only records
+ * which step they're on (so leaving and coming back resumes there) and, at the end, that setup is finished. Every step
+ * except the domain can be passed over and configured later from the admin console.
+ */
+export default function SetupWizard({ userUid }: SetupWizardProps): React.JSX.Element;
