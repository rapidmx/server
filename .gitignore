rrst-test
# LocalFsBlobStore's on-disk output when running against local yarn dev/testing (message/attachment blob
# content) - runtime state, not source.
/data
# Where the plugin host npm-installs plugins at startup (see src/plugins/PluginInstaller.ts) - runtime state.
/plugins
# Written by DefaultAccounts (`auth:password_file`, default "passwords") with plaintext credentials for
# any freshly-created default account (e.g. the initial admin) - must never be committed.
/passwords
# Fetched by `helm dependency update` (see helm/Chart.yaml) - regenerable from helm/Chart.lock (which
# *should* be committed, unlike these binary archives).
/helm/charts/*.tgz
# Local environment overrides (e.g. real API keys like `giphy__api_key`) - never commit real secrets;
# config.mongo.ts/config.sql.ts only ever check in placeholder defaults.
.env